{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "TAMAM Design Tokens",
    "version": "1.0.0",
    "brand": "TAMAM / تمام",
    "inspiration": "Getir-style: deep purple primary, vivid yellow accent, soft grey canvas, white rounded cards",
    "note": "Single source of truth. Never hardcode colours in apps — generate ts/dart outputs with `pnpm tokens:generate`."
  },
  "color": {
    "brand": {
      "purple": {
        "50": "#F2ECFF",
        "100": "#E4D9FE",
        "200": "#C9B4FD",
        "300": "#A98CFA",
        "400": "#8560F8",
        "500": "#5B32F6",
        "600": "#4C27EA",
        "700": "#3D1ECF",
        "800": "#2E169C",
        "900": "#1B0F5E"
      },
      "yellow": {
        "50": "#FFF8E1",
        "100": "#FFECB3",
        "200": "#FFE082",
        "300": "#FFD54F",
        "400": "#FFCA28",
        "500": "#FFC107",
        "600": "#FFB300",
        "700": "#FFA000",
        "800": "#FF8F00",
        "900": "#FF6F00"
      }
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F6F6FB",
      "100": "#EFEFF7",
      "200": "#E2E1F0",
      "300": "#CDCBE2",
      "400": "#A29FC0",
      "500": "#77739B",
      "600": "#585378",
      "700": "#3F3A5C",
      "800": "#2A2542",
      "900": "#1B1240",
      "1000": "#100A28"
    },
    "semantic": {
      "success": {
        "base": "#1FA463",
        "soft": "#E3F6EC",
        "strong": "#15794A"
      },
      "warning": {
        "base": "#F59E0B",
        "soft": "#FEF3DC",
        "strong": "#B45309"
      },
      "danger": {
        "base": "#E11D48",
        "soft": "#FDE7EC",
        "strong": "#9F1239"
      },
      "info": {
        "base": "#2563EB",
        "soft": "#E5EDFD",
        "strong": "#1E40AF"
      }
    },
    "service": {
      "ride": "#5B32F6",
      "delivery": "#3D1ECF",
      "homeService": "#FFC107",
      "chalet": "#8560F8",
      "urgent": "#E11D48"
    },
    "light": {
      "background": "#F6F6FB",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F2ECFF",
      "surfaceBrand": "#5B32F6",
      "surfaceBrandSoft": "#F2ECFF",
      "border": "#E2E1F0",
      "borderStrong": "#CDCBE2",
      "textPrimary": "#1B1240",
      "textSecondary": "#585378",
      "textTertiary": "#A29FC0",
      "textOnBrand": "#FFFFFF",
      "textOnAccent": "#1B1240",
      "primary": "#5B32F6",
      "primaryHover": "#4C27EA",
      "primaryPressed": "#3D1ECF",
      "accent": "#FFC107",
      "accentHover": "#FFB300",
      "accentPressed": "#FFA000",
      "overlay": "#1B124099",
      "skeleton": "#EFEFF7",
      "mapRoute": "#5B32F6",
      "mapPickup": "#1FA463",
      "mapDestination": "#E11D48"
    },
    "dark": {
      "background": "#100A28",
      "surface": "#1B1240",
      "surfaceAlt": "#2A2542",
      "surfaceBrand": "#5B32F6",
      "surfaceBrandSoft": "#2E169C",
      "border": "#2A2542",
      "borderStrong": "#3F3A5C",
      "textPrimary": "#F6F6FB",
      "textSecondary": "#A29FC0",
      "textTertiary": "#77739B",
      "textOnBrand": "#FFFFFF",
      "textOnAccent": "#1B1240",
      "primary": "#A98CFA",
      "primaryHover": "#C9B4FD",
      "primaryPressed": "#8560F8",
      "accent": "#FFCA28",
      "accentHover": "#FFD54F",
      "accentPressed": "#FFC107",
      "overlay": "#100A28CC",
      "skeleton": "#2A2542",
      "mapRoute": "#A98CFA",
      "mapPickup": "#4ED08D",
      "mapDestination": "#FB7185"
