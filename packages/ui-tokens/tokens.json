  "typography": {
    "fontFamily": {
      "arabic": "Tajawal",
      "latin": "Poppins",
      "mono": "JetBrains Mono",
      "fallbackArabic": "Noto Sans Arabic, Tahoma, sans-serif",
      "fallbackLatin": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
      "note": "The identity sheet specifies Poppins Rounded; Poppins is the same geometric skeleton and is the shipping face. Tajawal is the Arabic companion \u2014 geometric, same vertical rhythm, and it carries the weights the scale asks for."
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "arabicRules": {
      "letterSpacing": 0,
      "lineHeightMultiplier": 1.15,
      "note": "Arabic is cursive: letter-spacing pulls joined letterforms apart and must always be 0. Arabic also needs more leading than Latin at the same size, so every line height is multiplied when the locale is Arabic."
    },
    "scale": {
      "displayLg": {
        "size": 34,
        "lineHeight": 42,
        "weight": 800,
        "letterSpacing": -0.5
      },
      "displaySm": {
