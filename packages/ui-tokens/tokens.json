{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "TAMAM Design Tokens",
    "version": "2.0.0",
    "brand": "TAMAM / تمام",
    "identity": "Two constants, never negotiable: brand purple #5D3EBC and brand yellow #FFD300, over an ink #21154A and a night #191922. Everything else is derived from them.",
    "note": "Single source of truth. Never hardcode colours in apps — generate ts/dart outputs with `pnpm tokens:generate`.",
    "accessibility": "Every foreground/background pair the UI actually renders is verified against WCAG 2.1 AA in BOTH modes by packages/ui-tokens/scripts/verify-contrast.mjs, which runs in `pnpm tokens:generate`. Body text >= 4.5:1, large text, icons and UI borders >= 3:1.",
    "yellowRule": "Brand yellow reads 1.44:1 on white. It is a SURFACE colour carrying ink-coloured content, or a foreground on dark ground only. It must never be used for text, thin icons or hairlines on a light surface."
  },
  "color": {
    "brand": {
      "purple": {
        "50": "#F5F3FB",
        "100": "#E8E4F6",
        "200": "#CEC5EB",
        "300": "#AE9EDE",
        "400": "#8770CD",
        "500": "#5D3EBC",
        "600": "#5538AC",
        "700": "#4B329A",
        "800": "#3F2A83",
        "900": "#32206A"
      },
      "yellow": {
        "50": "#FFFBEB",
        "100": "#FFF7D1",
        "200": "#FFEFA3",
        "300": "#FFE56B",
        "400": "#FFDC33",
        "500": "#FFD300",
        "600": "#EFC100",
        "700": "#DCAC00",
        "800": "#C49100",
        "900": "#AD7700"
      }
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAF9FE",
      "100": "#F4F2FB",
      "200": "#E5E0F1",
      "300": "#CFC8E2",
      "400": "#A9A0C4",
      "500": "#8B83A6",
      "600": "#6E6889",
      "700": "#565073",
      "800": "#3A3160",
      "900": "#1B1140",
      "1000": "#191922"
    },
    "service": {
      "ride": "#5D3EBC",
      "delivery": "#4B329A",
      "homeService": "#C49100",
      "chalet": "#8770CD",
      "urgent": "#B3123A"
    },
    "light": {
      "background": "#F7F5FC",
      "surface": "#FFFFFF",
      "surfaceAlt": "#EFEAFB",
      "surfaceBrand": "#5D3EBC",
      "surfaceBrandSoft": "#EFE9FD",
      "border": "#E5E0F1",
      "borderStrong": "#8B83A6",
      "textPrimary": "#1B1140",
      "textSecondary": "#565073",
      "textTertiary": "#6E6889",
      "textOnBrand": "#FFFFFF",
      "textOnAccent": "#21154A",
      "primary": "#5D3EBC",
      "primaryHover": "#5338A5",
      "primaryPressed": "#49338E",
      "accent": "#FFD300",
      "accentHover": "#F0C600",
      "accentPressed": "#D9B300",
