      "successStrong": "#0A5C34",
      "warning": "#8A5200",
      "warningSoft": "#FDF1DC",
      "warningStrong": "#6B3F00",
      "danger": "#B3123A",
      "dangerSoft": "#FCE8ED",
      "dangerStrong": "#8C0E2D",
      "info": "#1D4FBF",
