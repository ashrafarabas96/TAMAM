{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "TAMAM Design Tokens",
    "version": "1.0.0",
    "brand": "TAMAM / تمام",
    "inspiration": "Getir-style: deep purple primary, vivid yellow accent, soft grey canvas, white rounded cards",
    "note": "Single source of truth. Never hardcode colours in apps — generate ts/dart outputs with `pnpm tokens:generate`."
  },
  "color": {
    "brand": {
      "purple": {
        "50": "#F1EEFB",
        "100": "#E3DDF7",
        "200": "#C7BBEF",
        "300": "#A996E4",
        "400": "#8A6FD8",
        "500": "#5D3EBC",
        "600": "#4E33A3",
        "700": "#3E2887",
        "800": "#2F1E68",
        "900": "#21154A"
      },
      "yellow": {
        "50": "#FFFBE5",
        "100": "#FFF6BF",
        "200": "#FFEE85",
        "300": "#FFE54D",
        "400": "#FFDC1A",
        "500": "#FFD300",
        "600": "#E6BE00",
        "700": "#C7A400",
        "800": "#9E8200",
        "900": "#6E5B00"
      }
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F7F7FA",
      "100": "#F1F1F5",
      "200": "#E4E4EC",
      "300": "#D1D1DC",
      "400": "#A8A8B8",
      "500": "#7A7A8C",
      "600": "#5C5C6E",
      "700": "#41414F",
      "800": "#2B2B36",
      "900": "#191922",
      "1000": "#0F0F15"
    },
    "semantic": {
      "success": { "base": "#1FA463", "soft": "#E3F6EC", "strong": "#15794A" },
      "warning": { "base": "#F59E0B", "soft": "#FEF3DC", "strong": "#B45309" },
      "danger": { "base": "#E11D48", "soft": "#FDE7EC", "strong": "#9F1239" },
      "info": { "base": "#2563EB", "soft": "#E5EDFD", "strong": "#1E40AF" }
    },
    "service": {
      "ride": "#5D3EBC",
      "delivery": "#F97316",
      "homeService": "#0EA5E9",
      "urgent": "#E11D48"
    },
    "light": {
      "background": "#F5F4FA",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F7F7FA",
      "surfaceBrand": "#5D3EBC",
      "surfaceBrandSoft": "#F1EEFB",
      "border": "#E4E4EC",
      "borderStrong": "#D1D1DC",
      "textPrimary": "#191922",
      "textSecondary": "#5C5C6E",
      "textTertiary": "#A8A8B8",
      "textOnBrand": "#FFFFFF",
      "textOnAccent": "#3E2887",
      "primary": "#5D3EBC",
      "primaryHover": "#4E33A3",
      "primaryPressed": "#3E2887",
      "accent": "#FFD300",
      "accentHover": "#E6BE00",
      "accentPressed": "#C7A400",
      "overlay": "#19192299",
      "skeleton": "#ECECF2",
      "mapRoute": "#5D3EBC",
      "mapPickup": "#1FA463",
      "mapDestination": "#E11D48"
    },
    "dark": {
      "background": "#12101C",
      "surface": "#1C1928",
      "surfaceAlt": "#241F35",
      "surfaceBrand": "#4E33A3",
      "surfaceBrandSoft": "#2A2142",
      "border": "#2E2942",
      "borderStrong": "#3B3554",
      "textPrimary": "#F4F2FA",
      "textSecondary": "#B9B4CC",
      "textTertiary": "#7E7894",
      "textOnBrand": "#FFFFFF",
      "textOnAccent": "#21154A",
      "primary": "#8A6FD8",
      "primaryHover": "#A996E4",
      "primaryPressed": "#5D3EBC",
      "accent": "#FFD300",
      "accentHover": "#FFE54D",
      "accentPressed": "#E6BE00",
      "overlay": "#000000B3",
      "skeleton": "#2A2540",
      "mapRoute": "#A996E4",
      "mapPickup": "#34D399",
      "mapDestination": "#FB7185"
    }
  },
  "typography": {
    "fontFamily": {
      "arabic": "Cairo",
      "latin": "Inter",
      "mono": "JetBrains Mono",
      "fallbackArabic": "Noto Sans Arabic, Tahoma, sans-serif",
      "fallbackLatin": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "scale": {
      "displayLg": { "size": 34, "lineHeight": 42, "weight": 800, "letterSpacing": -0.5 },
      "displaySm": { "size": 28, "lineHeight": 36, "weight": 800, "letterSpacing": -0.3 },
      "headingLg": { "size": 22, "lineHeight": 30, "weight": 700, "letterSpacing": 0 },
      "headingMd": { "size": 18, "lineHeight": 26, "weight": 700, "letterSpacing": 0 },
      "headingSm": { "size": 16, "lineHeight": 24, "weight": 600, "letterSpacing": 0 },
      "bodyLg": { "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0 },
      "bodyMd": { "size": 14, "lineHeight": 22, "weight": 400, "letterSpacing": 0 },
      "bodySm": { "size": 12, "lineHeight": 18, "weight": 400, "letterSpacing": 0 },
      "labelLg": { "size": 15, "lineHeight": 20, "weight": 600, "letterSpacing": 0.1 },
      "labelMd": { "size": 13, "lineHeight": 18, "weight": 600, "letterSpacing": 0.1 },
      "labelSm": { "size": 11, "lineHeight": 16, "weight": 600, "letterSpacing": 0.2 },
      "price": { "size": 20, "lineHeight": 28, "weight": 800, "letterSpacing": -0.2 }
    }
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 6, "sm": 10, "md": 12, "lg": 16, "xl": 20, "xxl": 28, "pill": 999, "card": 16, "button": 12, "sheet": 24, "banner": 16 },
  "elevation": {
    "card": { "y": 2, "blur": 10, "spread": 0, "color": "#1E10500F" },
    "raised": { "y": 6, "blur": 20, "spread": 0, "color": "#1E105019" },
    "sheet": { "y": -4, "blur": 24, "spread": 0, "color": "#1E105026" },
    "floating": { "y": 8, "blur": 28, "spread": 0, "color": "#1E105033" }
  },
  "size": {
    "touchTargetMin": 48,
    "buttonHeightLg": 52,
    "buttonHeightMd": 44,
    "buttonHeightSm": 36,
    "inputHeight": 52,
    "appBarHeight": 56,
    "bottomNavHeight": 64,
    "iconSm": 16,
    "iconMd": 22,
    "iconLg": 28,
    "avatarSm": 32,
    "avatarMd": 44,
    "avatarLg": 64,
    "serviceCardHeight": 118,
    "bannerHeroHeight": 156,
    "bannerInlineHeight": 96,
    "bannerAspectHero": 2.25,
    "bannerAspectInline": 3.6
  },
  "motion": {
    "durationFast": 120,
    "durationBase": 200,
    "durationSlow": 320,
    "durationBannerAutoplay": 4500,
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingEmphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)"
  },
  "banner": {
    "placements": {
      "HOME_HERO": { "aspectRatio": 2.25, "maxItems": 6, "autoplayMs": 4500, "style": "carousel" },
      "HOME_INLINE": { "aspectRatio": 3.6, "maxItems": 3, "autoplayMs": 0, "style": "stack" },
      "SERVICE_CATEGORY_TOP": { "aspectRatio": 3.0, "maxItems": 3, "autoplayMs": 5000, "style": "carousel" },
      "CHECKOUT_PROMO": { "aspectRatio": 4.5, "maxItems": 1, "autoplayMs": 0, "style": "single" },
      "ORDER_TRACKING": { "aspectRatio": 4.5, "maxItems": 1, "autoplayMs": 0, "style": "single" },
      "PARTNER_HOME": { "aspectRatio": 3.0, "maxItems": 3, "autoplayMs": 5000, "style": "carousel" }
    },
    "themes": {
      "purple": { "background": "#5D3EBC", "foreground": "#FFFFFF", "accent": "#FFD300" },
      "yellow": { "background": "#FFD300", "foreground": "#21154A", "accent": "#5D3EBC" },
      "dark": { "background": "#191922", "foreground": "#FFFFFF", "accent": "#FFD300" },
      "light": { "background": "#FFFFFF", "foreground": "#191922", "accent": "#5D3EBC" },
      "gradientPurple": { "background": "linear-gradient(135deg,#5D3EBC 0%,#3E2887 100%)", "foreground": "#FFFFFF", "accent": "#FFD300" },
      "gradientSunset": { "background": "linear-gradient(135deg,#FFD300 0%,#F97316 100%)", "foreground": "#21154A", "accent": "#5D3EBC" }
    }
  }
}
