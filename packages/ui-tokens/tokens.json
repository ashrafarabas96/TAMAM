  },
  "typography": {
    "fontFamily": {
      "arabic": "Cairo",
      "latin": "Inter",
      "mono": "JetBrains Mono",
      "fallbackArabic": "Noto Sans Arabic, Tahoma, sans-serif",
      "fallbackLatin": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "displayLg": {
        "size": 34,
        "lineHeight": 42,
        "weight": 800,
        "letterSpacing": -0.5
      },
      "displaySm": {
        "size": 28,
        "lineHeight": 36,
        "weight": 800,
        "letterSpacing": -0.3
      },
      "headingLg": {
        "size": 22,
        "lineHeight": 30,
        "weight": 700,
        "letterSpacing": 0
      },
      "headingMd": {
        "size": 18,
        "lineHeight": 26,
        "weight": 700,
        "letterSpacing": 0
      },
      "headingSm": {
        "size": 16,
        "lineHeight": 24,
        "weight": 600,
        "letterSpacing": 0
      },
      "bodyLg": {
        "size": 16,
        "lineHeight": 24,
        "weight": 400,
        "letterSpacing": 0
      },
      "bodyMd": {
        "size": 14,
        "lineHeight": 22,
        "weight": 400,
        "letterSpacing": 0
      },
      "bodySm": {
        "size": 12,
        "lineHeight": 18,
        "weight": 400,
        "letterSpacing": 0
      },
      "labelLg": {
        "size": 15,
        "lineHeight": 20,
        "weight": 600,
        "letterSpacing": 0.1
      },
      "labelMd": {
        "size": 13,
        "lineHeight": 18,
        "weight": 600,
        "letterSpacing": 0.1
      },
      "labelSm": {
        "size": 11,
        "lineHeight": 16,
        "weight": 600,
        "letterSpacing": 0.2
      },
      "price": {
        "size": 20,
        "lineHeight": 28,
        "weight": 800,
        "letterSpacing": -0.2
      }
    },
    "family": {
      "latin": "Poppins",
      "arabic": "Tajawal",
      "mono": "JetBrains Mono",
      "note": "Identity sheet specifies Poppins Rounded; Poppins is the same geometric skeleton and is the shipping face. Tajawal is the Arabic companion — geometric, same vertical rhythm."
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 28,
    "pill": 999,
    "card": 16,
    "button": 12,
    "sheet": 24,
    "banner": 16
  },
  "elevation": {
    "card": {
      "y": 2,
      "blur": 10,
      "spread": 0,
      "color": "#1E10500F"
    },
    "raised": {
      "y": 6,
      "blur": 20,
      "spread": 0,
      "color": "#1E105019"
    },
    "sheet": {
      "y": -4,
      "blur": 24,
      "spread": 0,
      "color": "#1E105026"
    },
    "floating": {
      "y": 8,
      "blur": 28,
      "spread": 0,
      "color": "#1E105033"
    }
  },
  "size": {
    "touchTargetMin": 48,
    "buttonHeightLg": 52,
    "buttonHeightMd": 44,
    "buttonHeightSm": 36,
    "inputHeight": 52,
    "appBarHeight": 56,
    "bottomNavHeight": 64,
    "iconSm": 16,
    "iconMd": 22,
    "iconLg": 28,
    "avatarSm": 32,
    "avatarMd": 44,
    "avatarLg": 64,
    "serviceCardHeight": 120,
    "bannerHeroHeight": 156,
    "bannerInlineHeight": 96,
    "bannerAspectHero": 2.25,
    "bannerAspectInline": 3.6
  },
  "motion": {
    "durationFast": 120,
    "durationBase": 200,
    "durationSlow": 320,
    "durationBannerAutoplay": 4500,
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingEmphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)"
  },
  "banner": {
    "placements": {
      "HOME_HERO": {
        "aspectRatio": 2.25,
        "maxItems": 6,
        "autoplayMs": 4500,
        "style": "carousel"
      },
      "HOME_INLINE": {
        "aspectRatio": 3.6,
        "maxItems": 3,
        "autoplayMs": 0,
        "style": "stack"
      },
      "SERVICE_CATEGORY_TOP": {
        "aspectRatio": 3.0,
        "maxItems": 3,
        "autoplayMs": 5000,
        "style": "carousel"
      },
      "CHECKOUT_PROMO": {
        "aspectRatio": 4.5,
        "maxItems": 1,
        "autoplayMs": 0,
        "style": "single"
      },
      "ORDER_TRACKING": {
        "aspectRatio": 4.5,
        "maxItems": 1,
        "autoplayMs": 0,
        "style": "single"
      },
      "PARTNER_HOME": {
        "aspectRatio": 3.0,
        "maxItems": 3,
        "autoplayMs": 5000,
        "style": "carousel"
      }
    },
    "themes": {
      "purple": {
        "background": "#5D3EBC",
        "foreground": "#FFFFFF",
        "accent": "#FFD300"
      },
      "yellow": {
        "background": "#FFD300",
        "foreground": "#21154A",
        "accent": "#5D3EBC"
      },
      "dark": {
        "background": "#191922",
        "foreground": "#FFFFFF",
        "accent": "#FFD300"
      },
      "light": {
        "background": "#FFFFFF",
        "foreground": "#191922",
        "accent": "#5D3EBC"
      },
      "gradientPurple": {
        "background": "linear-gradient(135deg,#5D3EBC 0%,#3E2887 100%)",
        "foreground": "#FFFFFF",
        "accent": "#FFD300"
      },
      "gradientSunset": {
        "background": "linear-gradient(135deg,#FFD300 0%,#F97316 100%)",
        "foreground": "#21154A",
        "accent": "#5D3EBC"
      }
    }
  }
}
