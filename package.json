{
  "name": "tamam",
  "private": true,
  "version": "1.0.0",
  "description": "TAMAM — Universal Local Services Platform (Ride, Delivery, Home Services)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/api' --filter './apps/admin-web' build",
    "dev": "pnpm -r --parallel --filter './apps/api' --filter './apps/admin-web' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tamam/api test:e2e",
    "db:migrate": "pnpm --filter @tamam/api prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @tamam/api prisma:migrate:dev",
    "db:seed": "pnpm --filter @tamam/api seed",
    "db:reset": "pnpm --filter @tamam/api prisma:reset",
    "tokens:generate": "pnpm --filter @tamam/ui-tokens generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "security:audit": "pnpm audit --audit-level=high",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.6": "1.20.6",
      "ws@<8.21.0": "8.21.0",
      "multer@<2.2.0": "2.2.0",
      "lodash@<4.18.0": "4.18.0",
      "js-yaml@<4.3.1": "4.3.1",
      "postcss@<8.5.18": "8.5.18",
      "sharp@<0.35.0": "0.35.0"
    }
  }
}
