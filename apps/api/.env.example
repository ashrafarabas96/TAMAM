# ---------------------------------------------------------------- runtime
NODE_ENV=development            # local | development | staging | production | test
PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=debug                 # trace | debug | info | warn | error
TRUST_PROXY=false

# ------------------------------------------------------------- datastores
DATABASE_URL=postgresql://tamam:tamam@localhost:5432/tamam
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- security
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-string-please
JWT_REFRESH_SECRET=change-me-to-another-random-48-byte-base64-string
JWT_ISSUER=tamam
# HMAC pepper for OTP / PIN hashing (openssl rand -base64 32)
OTP_PEPPER=change-me-to-a-random-32-byte-base64-string
# AES-256-GCM key, base64 of exactly 32 random bytes (openssl rand -base64 32).
# The placeholder below is valid base64 so `cp .env.example .env` boots, and contains
# "example" so the production guard in env.schema.ts refuses to start with it.
ENCRYPTION_KEY=exampleexampleexampleexampleexampleexampleA=
CORS_ORIGINS=http://localhost:3001,https://admin.tamam.app
ADMIN_WEB_URL=http://localhost:3001

# ------------------------------------------------------------ providers
SMS_PROVIDER=console            # console | http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=TAMAM

PUSH_PROVIDER=console           # console | fcm
FCM_SERVICE_ACCOUNT_JSON=       # base64-encoded service account JSON

EMAIL_PROVIDER=console          # console | smtp
SMTP_URL=

MAPS_PROVIDER=osrm              # osrm | google
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

STORAGE_PROVIDER=s3             # s3 (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tamam
S3_SECRET_KEY=tamam-secret
S3_BUCKET_PRIVATE=tamam-private
S3_BUCKET_PUBLIC=tamam-public
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/tamam-public

PAYMENT_GATEWAY_PROVIDER=none   # none | mock | lahza | stripe
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# -------------------------------------------------------------- platform
DEFAULT_CURRENCY=ILS
DEFAULT_LANGUAGE=ar
DEFAULT_TIMEZONE=Asia/Jerusalem
DEEP_LINK_SCHEME=tamam
SHARE_TRIP_BASE_URL=https://tamam.app/t

# ------------------------------------------------------------ observability
METRICS_ENABLED=true
ERROR_TRACKING_DSN=

# --------------------------------------------------------------- operations
# Container entrypoint runs `prisma migrate deploy` when true (exactly one replica).
RUN_MIGRATIONS=false
# Password given to every seeded staff account. Development only — prisma/seed.ts
# refuses to run with NODE_ENV=production. Defaults to TamamAdmin#2026.
SEED_ADMIN_PASSWORD=
