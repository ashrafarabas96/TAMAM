// =====================================================================
// TAMAM — PostgreSQL / PostGIS schema (Prisma)
// ---------------------------------------------------------------------
// Conventions
//   • Models are PascalCase, tables/columns snake_case (@@map / @map).
//   • All public IDs are UUID v4 generated by PostgreSQL (pgcrypto).
//   • All timestamps are timestamptz stored in UTC.
//   • Money is BIGINT integer minor units + ISO-4217 currency code. Never float.
//   • Geo columns are PostGIS geography(Point,4326) / geography(Polygon,4326)
//     declared as Unsupported and queried through $queryRaw. GIST indexes and
//     the postgis/pgcrypto extensions live in the SQL migrations.
//   • Financial + audit tables are append-only (enforced by DB triggers in
//     migrations, see 0001_init/migration.sql).
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, pg_trgm]
}

