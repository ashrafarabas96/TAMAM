/// Raw impression/click/dismiss events (batched from clients, deduped by (banner,user,session,type,minute)).
model BannerEvent {
  id         BigInt          @id @default(autoincrement())
  bannerId   String          @map("banner_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  sessionId  String          @map("session_id") @db.VarChar(128)
  type       BannerEventType
  placement  BannerPlacement
  platform   String?         @db.VarChar(10)
  zoneId     String?         @map("zone_id") @db.Uuid
  dedupeKey  String          @unique @map("dedupe_key") @db.VarChar(200)
