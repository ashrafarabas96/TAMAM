// ------------------------------------------------------------ identity
model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String        @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?   @map("phone_verified_at") @db.Timestamptz(6)
  email         String?       @unique @db.VarChar(200)
  fullName      String?       @map("full_name") @db.VarChar(120)
  profileImageId String?      @map("profile_image_id") @db.Uuid
  language      String        @default("ar") @db.VarChar(5)
  currency      String        @default("ILS") @db.VarChar(3)
  timezone      String        @default("Asia/Jerusalem") @db.VarChar(60)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  statusReason  String?       @map("status_reason") @db.VarChar(500)
  statusUntil   DateTime?     @map("status_until") @db.Timestamptz(6)
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  profileImage   MediaAsset?  @relation("UserProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  roles          UserRoleAssignment[]
  sessions       UserSession[]
  adminCredential AdminCredential?
  customer       CustomerProfile?
  partner        PartnerProfile?
  pushTokens     PushToken[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  auditLogs      AuditLog[]           @relation("AuditActor")
  supportTicketsRaised SupportTicket[] @relation("TicketRaisedBy")
  supportTicketsAssigned SupportTicket[] @relation("TicketAssignedTo")
  supportMessages SupportMessage[]
  disputeMessages DisputeMessage[]
  chatMemberships ChatMember[]
  messages       Message[]
  reviewsGiven   Review[]             @relation("ReviewRater")
  reviewsReceived Review[]            @relation("ReviewRatee")
  mediaUploaded  MediaAsset[]         @relation("MediaUploader")
  restrictionsCreated Restriction[]   @relation("RestrictionCreatedBy")
  campaignsCreated Campaign[]         @relation("CampaignCreatedBy")
  walletAdjustments LedgerTransaction[] @relation("LedgerActor")
  configChanges  SystemConfig[]       @relation("ConfigUpdatedBy")
  sosAlerts      SosAlert[]
  userReports    UserReport[]         @relation("ReportReporter")
  userReportsAgainst UserReport[]     @relation("ReportReported")
  bannerEvents   BannerEvent[]
  riskSignals    RiskSignalEvent[]
  jobEvents      JobEvent[]           @relation("JobEventActor")
  disputesDecided Dispute[]           @relation("DisputeDecidedBy")
  refundsIssued  Refund[]             @relation("RefundIssuedBy")
  withdrawalsDecided Withdrawal[]     @relation("WithdrawalDecidedBy")
  documentsVerified PartnerDocument[] @relation("DocumentVerifiedBy")
  vehiclesVerified Vehicle[]          @relation("VehicleVerifiedBy")
  partnersReviewed PartnerProfile[]   @relation("PartnerReviewedBy")

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
  ownedChalets   Chalet[]        @relation("ChaletOwner")
  chaletBookings ChaletBooking[] @relation("ChaletCustomer")
}

model AdminRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(40) // e.g. SUPER_ADMIN, DISPATCHER
  description String?  @db.VarChar(300)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions AdminRolePermission[]
  users       UserRoleAssignment[]

  @@map("admin_roles")
}

model AdminPermission {
  key         String   @id @db.VarChar(80) // e.g. refunds.issue
  description String   @db.VarChar(300)
  isSensitive Boolean  @default(false) @map("is_sensitive")

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(80)

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("admin_role_permissions")
}

/// Multi-role assignment. CUSTOMER / PARTNER are stored here too for a single source of truth.
model UserRoleAssignment {
  userId     String    @map("user_id") @db.Uuid
  role       UserRole
  adminRoleId String?  @map("admin_role_id") @db.Uuid
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminRole AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Email + password credentials for staff accounts (customers/partners use OTP only).
model AdminCredential {
  userId            String    @id @map("user_id") @db.Uuid
  email             String    @unique @db.VarChar(200)
  passwordHash      String    @map("password_hash") @db.VarChar(255) // argon2id
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  totpSecretEnc     String?   @map("totp_secret_enc") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

/// One row per device login. Refresh tokens are stored hashed and rotated on every use.
model UserSession {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  deviceId         String         @map("device_id") @db.VarChar(128)
  deviceName       String?        @map("device_name") @db.VarChar(120)
  platform         DevicePlatform @default(unknown)
  appVersion       String?        @map("app_version") @db.VarChar(40)
  refreshTokenHash String         @unique @map("refresh_token_hash") @db.VarChar(128)
  /// Family id survives rotation; reuse of an old token revokes the whole family.
  tokenFamily      String         @map("token_family") @db.Uuid
  ipAddress        String?        @map("ip_address") @db.VarChar(64)
  userAgent        String?        @map("user_agent") @db.VarChar(300)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?        @map("revoked_reason") @db.VarChar(120)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OtpRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String    @db.VarChar(20)
  codeHash     String    @map("code_hash") @db.VarChar(128)
  purpose      String    @default("LOGIN") @db.VarChar(30)
  audience     String    @default("CUSTOMER") @db.VarChar(20)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  deviceId     String?   @map("device_id") @db.VarChar(128)
  providerRef  String?   @map("provider_ref") @db.VarChar(120)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model PushToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  deviceId  String         @map("device_id") @db.VarChar(128)
  platform  DevicePlatform
  token     String         @db.VarChar(512)
  isActive  Boolean        @default(true) @map("is_active")
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([token])
  @@map("push_tokens")
}

// ------------------------------------------------------------ customers
model CustomerProfile {
  userId        String   @id @map("user_id") @db.Uuid
  ratingSum     Int      @default(0) @map("rating_sum")
  ratingCount   Int      @default(0) @map("rating_count")
  completedJobs Int      @default(0) @map("completed_jobs")
  cancelledJobs Int      @default(0) @map("cancelled_jobs")
  referralCode  String   @unique @map("referral_code") @db.VarChar(12)
  referredById  String?  @map("referred_by_id") @db.Uuid
  firstJobAt    DateTime? @map("first_job_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPlaces  SavedPlace[]
  favorites    FavoriteService[]
  jobs         Job[]           @relation("JobCustomer")
  wallet       Wallet?         @relation("CustomerWallet")
  promoRedemptions PromoRedemption[]
  referralRewardsAsInviter ReferralReward[] @relation("ReferralInviter")
  referralRewardsAsInvitee ReferralReward[] @relation("ReferralInvitee")
  disputes     Dispute[]       @relation("DisputeCustomer")

  @@map("customer_profiles")
}

model SavedPlace {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  kind       SavedPlaceKind @default(CUSTOM)
  label      String         @db.VarChar(60)
  formatted  String         @db.VarChar(300)
  street     String?        @db.VarChar(120)
  building   String?        @db.VarChar(60)
  floor      String?        @db.VarChar(20)
  apartment  String?        @db.VarChar(20)
  city       String?        @db.VarChar(80)
  notes      String?        @db.VarChar(300)
  placeId    String?        @map("place_id") @db.VarChar(200)
  lat        Decimal        @db.Decimal(9, 6)
  lng        Decimal        @db.Decimal(9, 6)
  /// Maintained by trigger trg_sync_point_location from lat/lng (optional so Prisma create works).
  location   Unsupported("geography(Point, 4326)")?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  @@index([customerId])
  @@map("saved_places")
}

model FavoriteService {
  customerId String   @map("customer_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([customerId, categoryId])
  @@map("favorite_services")
}

// ------------------------------------------------------------- partners
model PartnerProfile {
  userId             String             @id @map("user_id") @db.Uuid
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  reviewedById       String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote         String?            @map("review_note") @db.VarChar(500)
  suspendedUntil     DateTime?          @map("suspended_until") @db.Timestamptz(6)
  onboardingStep     Int                @default(0) @map("onboarding_step")
  acceptedTermsVersion String?          @map("accepted_terms_version") @db.VarChar(20)
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date
  nationalIdEnc      String?            @map("national_id_enc") @db.VarChar(255) // AES-GCM encrypted
  city               String?            @db.VarChar(80)
  yearsOfExperience  Int?               @map("years_of_experience")
  ratingSum          Int                @default(0) @map("rating_sum")
  ratingCount        Int                @default(0) @map("rating_count")
  completedJobs      Int                @default(0) @map("completed_jobs")
  cancelledJobs      Int                @default(0) @map("cancelled_jobs")
  offersReceived     Int                @default(0) @map("offers_received")
  offersAccepted     Int                @default(0) @map("offers_accepted")
  penaltyPoints      Int                @default(0) @map("penalty_points")
  activeVehicleId    String?            @map("active_vehicle_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                @relation("PartnerReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  roles        PartnerRole[]
  skills       PartnerSkill[]
  categories   PartnerCategory[]
  zones        PartnerZone[]
  documents    PartnerDocument[]
  availability PartnerAvailability?
  vehicles     Vehicle[]
  activeVehicle Vehicle?            @relation("PartnerActiveVehicle", fields: [activeVehicleId], references: [id], onDelete: SetNull)
  jobs         Job[]                @relation("JobPartner")
  assignments  JobAssignment[]
  wallet       Wallet?              @relation("PartnerWallet")
  bankAccounts PartnerBankAccount[]
  withdrawals  Withdrawal[]
  quotes       ServiceQuote[]
  disputes     Dispute[]            @relation("DisputePartner")
  trackingPoints JobTrackingPoint[]

  @@index([verificationStatus])
  @@map("partner_profiles")
}

model PartnerRole {
