// ----------------------------------------------------------------- jobs
model Job {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number              String         @unique @db.VarChar(20) // TM-YYMM-NNNNNN
  type                JobType
  status              JobStatus      @default(DRAFT)
  /// Optimistic concurrency (spec §103). Every state change increments it.
  version             Int            @default(0)
  customerId          String         @map("customer_id") @db.Uuid
  partnerId           String?        @map("partner_id") @db.Uuid
  vehicleId           String?        @map("vehicle_id") @db.Uuid
  vehicleTypeId       String?        @map("vehicle_type_id") @db.Uuid
  categoryId          String?        @map("category_id") @db.Uuid
  subcategoryId       String?        @map("subcategory_id") @db.Uuid
  zoneId              String         @map("zone_id") @db.Uuid
  scheduling          SchedulingMode @default(NOW)
  scheduledFor        DateTime?      @map("scheduled_for") @db.Timestamptz(6)
  urgency             JobUrgency     @default(STANDARD)
  currency            String         @db.VarChar(3)
  paymentMethod       PaymentMethod  @map("payment_method")
  estimatedTotalMinor BigInt?        @map("estimated_total_minor")
  finalTotalMinor     BigInt?        @map("final_total_minor")
  /// Snapshot of FareBreakdownLine[] at completion (or estimate before that).
  breakdown           Json           @default("[]")
  pricingSnapshotId   String?        @map("pricing_snapshot_id") @db.Uuid
  distanceMeters      Int?           @map("distance_meters")
  durationSeconds     Int?           @map("duration_seconds")
  actualDistanceMeters Int?          @map("actual_distance_meters")
  actualDurationSeconds Int?         @map("actual_duration_seconds")
  routePolyline       String?        @map("route_polyline")
  etaToPickupSeconds  Int?           @map("eta_to_pickup_seconds")
  etaToDestinationSeconds Int?       @map("eta_to_destination_seconds")
  description         String?        @db.VarChar(2000)
  notes               String?        @db.VarChar(500)
  dynamicFields       Json           @default("{}") @map("dynamic_fields")
  preferredDate       DateTime?      @map("preferred_date") @db.Date
  preferredTimeSlot   String?        @map("preferred_time_slot") @db.VarChar(20)
  tripPinRequired     Boolean        @default(false) @map("trip_pin_required")
  tripPinHash         String?        @map("trip_pin_hash") @db.VarChar(128)
  tripPinEnc          String?        @map("trip_pin_enc") @db.VarChar(255)
  pickupOtpRequired   Boolean        @default(false) @map("pickup_otp_required")
  pickupOtpHash       String?        @map("pickup_otp_hash") @db.VarChar(128)
  pickupOtpEnc        String?        @map("pickup_otp_enc") @db.VarChar(255)
  deliveryOtpRequired Boolean        @default(false) @map("delivery_otp_required")
  deliveryOtpHash     String?        @map("delivery_otp_hash") @db.VarChar(128)
  deliveryOtpEnc      String?        @map("delivery_otp_enc") @db.VarChar(255)
  promoCodeId         String?        @map("promo_code_id") @db.Uuid
  promoDiscountMinor  BigInt         @default(0) @map("promo_discount_minor")
  cancellationReasonCode String?     @map("cancellation_reason_code") @db.VarChar(40)
  cancellationReasonText String?     @map("cancellation_reason_text") @db.VarChar(500)
  cancelledBy         JobActorType?  @map("cancelled_by")
  cancellationFeeMinor BigInt        @default(0) @map("cancellation_fee_minor")
  dispatchWave        Int            @default(0) @map("dispatch_wave")
  dispatchStartedAt   DateTime?      @map("dispatch_started_at") @db.Timestamptz(6)
  dispatchDeadlineAt  DateTime?      @map("dispatch_deadline_at") @db.Timestamptz(6)
  assignedAt          DateTime?      @map("assigned_at") @db.Timestamptz(6)
  partnerArrivedAt    DateTime?      @map("partner_arrived_at") @db.Timestamptz(6)
  startedAt           DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(6)
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  /// Banner attribution: campaign clicked before this job was created (within window).
  attributedCampaignId String?       @map("attributed_campaign_id") @db.Uuid
  idempotencyKey      String?        @unique @map("idempotency_key") @db.VarChar(128)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        CustomerProfile     @relation("JobCustomer", fields: [customerId], references: [userId])
  partner         PartnerProfile?     @relation("JobPartner", fields: [partnerId], references: [userId], onDelete: SetNull)
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleType     VehicleType?        @relation(fields: [vehicleTypeId], references: [id])
  category        ServiceCategory?    @relation(fields: [categoryId], references: [id])
  subcategory     ServiceSubcategory? @relation(fields: [subcategoryId], references: [id])
  zone            ServiceZone         @relation(fields: [zoneId], references: [id])
  pricingSnapshot PricingSnapshot?    @relation(fields: [pricingSnapshotId], references: [id])
  promoCode       PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  attributedCampaign Campaign?        @relation(fields: [attributedCampaignId], references: [id], onDelete: SetNull)
  stops           JobStop[]
  media           JobMedia[]
  serviceOptions  JobServiceOption[]
  assignments     JobAssignment[]
  events          JobEvent[]
  trackingPoints  JobTrackingPoint[]
  delivery        JobDeliveryDetails?
  quotes          ServiceQuote[]
  payments        Payment[]
  ledgerTransactions LedgerTransaction[]
  reviews         Review[]
  chat            Chat?
  shareLinks      JobShareLink[]
  sosAlerts       SosAlert[]
  supportTickets  SupportTicket[]
  disputes        Dispute[]
  promoRedemption PromoRedemption?
  receipt         Receipt?
  userReports     UserReport[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([partnerId, createdAt(sort: Desc)])
  @@index([status, type])
  @@index([zoneId, status])
  @@index([scheduling, scheduledFor])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

model JobStop {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String      @map("job_id") @db.Uuid
  sequence     Int
  kind         JobStopKind
  formatted    String      @db.VarChar(300)
  street       String?     @db.VarChar(120)
  building     String?     @db.VarChar(60)
  floor        String?     @db.VarChar(20)
  apartment    String?     @db.VarChar(20)
  city         String?     @db.VarChar(80)
  notes        String?     @db.VarChar(300)
  placeId      String?     @map("place_id") @db.VarChar(200)
  lat          Decimal     @db.Decimal(9, 6)
  lng          Decimal     @db.Decimal(9, 6)
  location     Unsupported("geography(Point, 4326)")?
  contactName  String?     @map("contact_name") @db.VarChar(80)
  contactPhoneEnc String?  @map("contact_phone_enc") @db.VarChar(255)
  arrivedAt    DateTime?   @map("arrived_at") @db.Timestamptz(6)
  completedAt  DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@map("job_stops")
}

model JobMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  /// PROBLEM (customer upload), INSPECTION (partner), COMPLETION (partner), PROOF (delivery)
  context   String   @default("PROBLEM") @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job   Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id])

  @@unique([jobId, mediaId])
  @@map("job_media")
}

model JobServiceOption {
  jobId      String @map("job_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid
  priceMinor BigInt @map("price_minor")

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  option ServiceOption @relation(fields: [optionId], references: [id])

  @@id([jobId, optionId])
  @@map("job_service_options")
}

model JobDeliveryDetails {
  jobId               String          @id @map("job_id") @db.Uuid
  packageCategoryId   String          @map("package_category_id") @db.Uuid
  approximateSize     PackageSize     @map("approximate_size")
  approximateWeightKg Decimal?        @map("approximate_weight_kg") @db.Decimal(8, 2)
  senderName          String          @map("sender_name") @db.VarChar(80)
  senderPhoneEnc      String          @map("sender_phone_enc") @db.VarChar(255)
  recipientName       String          @map("recipient_name") @db.VarChar(80)
  recipientPhoneEnc   String          @map("recipient_phone_enc") @db.VarChar(255)
  deliveryNotes       String?         @map("delivery_notes") @db.VarChar(500)
  pickupVerifiedAt    DateTime?       @map("pickup_verified_at") @db.Timestamptz(6)
  pickupVerifiedMethod String?        @map("pickup_verified_method") @db.VarChar(20)
  podReceiverName     String?         @map("pod_receiver_name") @db.VarChar(80)
  podPhotoMediaId     String?         @map("pod_photo_media_id") @db.Uuid
  podSignatureMediaId String?         @map("pod_signature_media_id") @db.Uuid
  podLat              Decimal?        @map("pod_lat") @db.Decimal(9, 6)
  podLng              Decimal?        @map("pod_lng") @db.Decimal(9, 6)
  podOtpVerified      Boolean         @default(false) @map("pod_otp_verified")
  podTimestamp        DateTime?       @map("pod_timestamp") @db.Timestamptz(6)

  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  packageCategory PackageCategory @relation(fields: [packageCategoryId], references: [id])
  podPhoto        MediaAsset?     @relation("PodPhoto", fields: [podPhotoMediaId], references: [id], onDelete: SetNull)
  podSignature    MediaAsset?     @relation("PodSignature", fields: [podSignatureMediaId], references: [id], onDelete: SetNull)

  @@map("job_delivery_details")
}

/// One row per offer to a partner. The unique partial index (migration) guarantees
/// at most ONE ACCEPTED assignment per job — the DB-level race protection.
model JobAssignment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String           @map("job_id") @db.Uuid
  partnerId    String           @map("partner_id") @db.Uuid
  wave         Int
  status       AssignmentStatus @default(OFFERED)
  score        Decimal          @db.Decimal(8, 4)
  distanceMeters Int            @map("distance_meters")
  etaSeconds   Int              @map("eta_seconds")
  estimatedEarningsMinor BigInt @map("estimated_earnings_minor")
  isManual     Boolean          @default(false) @map("is_manual")
  assignedById String?          @map("assigned_by_id") @db.Uuid
  offeredAt    DateTime         @default(now()) @map("offered_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  respondedAt  DateTime?        @map("responded_at") @db.Timestamptz(6)
  releasedAt   DateTime?        @map("released_at") @db.Timestamptz(6)
  releaseReason String?         @map("release_reason") @db.VarChar(200)

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partner PartnerProfile @relation(fields: [partnerId], references: [userId])

  @@index([jobId, status])
  @@index([partnerId, status])
  @@index([expiresAt])
  @@map("job_assignments")
}

/// Append-only timeline (spec §137/§138).
model JobEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String       @map("job_id") @db.Uuid
  type       String       @db.VarChar(60)
  fromStatus JobStatus?   @map("from_status")
  toStatus   JobStatus?   @map("to_status")
  actorType  JobActorType @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  data       Json?
  lat        Decimal?     @db.Decimal(9, 6)
  lng        Decimal?     @db.Decimal(9, 6)
  requestId  String?      @map("request_id") @db.VarChar(64)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation("JobEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([type, createdAt])
  @@map("job_events")
}

/// Raw GPS history for active jobs (retention policy applies).
model JobTrackingPoint {
  id         BigInt   @id @default(autoincrement())
  jobId      String   @map("job_id") @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  location   Unsupported("geography(Point, 4326)")?
  accuracy   Decimal  @db.Decimal(7, 2)
  heading    Decimal? @db.Decimal(5, 2)
  speed      Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partner PartnerProfile @relation(fields: [partnerId], references: [userId], onDelete: Cascade)

  @@index([jobId, recordedAt])
  @@index([recordedAt])
  @@map("job_tracking_points")
}

model JobShareLink {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  viewCount Int       @default(0) @map("view_count")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_share_links")
}

model SosAlert {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  lat        Decimal   @db.Decimal(9, 6)
  lng        Decimal   @db.Decimal(9, 6)
  note       String?   @db.VarChar(300)
  acknowledgedById String? @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([resolvedAt])
  @@map("sos_alerts")
}

// --------------------------------------------------------------- quotes
/// Every revision is its own immutable row; `supersedesQuoteId` links the chain (spec §43).
model ServiceQuote {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                String      @map("job_id") @db.Uuid
  partnerId            String      @map("partner_id") @db.Uuid
  kind                 QuoteKind   @default(INITIAL)
  revision             Int         @default(1)
  status               QuoteStatus @default(SUBMITTED)
  supersedesQuoteId    String?     @map("supersedes_quote_id") @db.Uuid
  currency             String      @db.VarChar(3)
  laborCostMinor       BigInt      @map("labor_cost_minor")
  partsCostMinor       BigInt      @map("parts_cost_minor")
  additionalFeesMinor  BigInt      @map("additional_fees_minor")
  discountMinor        BigInt      @default(0) @map("discount_minor")
  taxMinor             BigInt      @default(0) @map("tax_minor")
  totalMinor           BigInt      @map("total_minor")
  description          String?     @db.VarChar(1000)
  estimatedDurationMin Int?        @map("estimated_duration_min")
  submittedAt          DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  decidedAt            DateTime?   @map("decided_at") @db.Timestamptz(6)
  decidedById          String?     @map("decided_by_id") @db.Uuid
  decisionNote         String?     @map("decision_note") @db.VarChar(500)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partner    PartnerProfile   @relation(fields: [partnerId], references: [userId])
  supersedes ServiceQuote?    @relation("QuoteRevisions", fields: [supersedesQuoteId], references: [id])
  revisions  ServiceQuote[]   @relation("QuoteRevisions")
  items      ServiceQuoteItem[]

  @@index([jobId, revision])
  @@index([status])
  @@map("service_quotes")
}

model ServiceQuoteItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String        @map("quote_id") @db.Uuid
  kind           QuoteItemKind
  description    String        @db.VarChar(200)
  quantity       Decimal       @db.Decimal(10, 2)
  unitPriceMinor BigInt        @map("unit_price_minor")
  totalMinor     BigInt        @map("total_minor")
  sortOrder      Int           @default(0) @map("sort_order")

  quote ServiceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("service_quote_items")
}

// -------------------------------------------------------------- pricing
model PricingRule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType       JobType   @map("job_type")
  zoneId        String?   @map("zone_id") @db.Uuid
  vehicleTypeId String?   @map("vehicle_type_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  currency      String    @db.VarChar(3)
  name          String    @db.VarChar(80)
  priority      Int       @default(0)
  /// Shape validated by ridePricingRuleSchema / deliveryPricingRuleSchema / homeServicePricingRuleSchema.
  rule          Json
  validFrom     DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(6)
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone        ServiceZone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  vehicleType VehicleType?     @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  snapshots   PricingSnapshot[]

  @@index([jobType, zoneId, isActive, priority(sort: Desc)])
  @@map("pricing_rules")
}

/// Immutable copy of the rule + config used for a job (spec §49).
model PricingSnapshot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pricingRuleId   String?  @map("pricing_rule_id") @db.Uuid
  jobType         JobType  @map("job_type")
  currency        String   @db.VarChar(3)
  rule            Json
  surgeMultiplier Decimal  @default(1) @map("surge_multiplier") @db.Decimal(4, 2)
  commissionPercent Decimal @map("commission_percent") @db.Decimal(5, 2)
  commissionFixedMinor BigInt @default(0) @map("commission_fixed_minor")
  inputs          Json // distance, duration, size, weight, urgency, options...
  breakdown       Json // FareBreakdownLine[]
  totalMinor      BigInt   @map("total_minor")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  jobs        Job[]

  @@map("pricing_snapshots")
}

model SurgeOverride {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  jobType    JobType  @map("job_type")
  multiplier Decimal  @db.Decimal(4, 2)
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String   @db.VarChar(300)
  createdById String? @map("created_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  zone ServiceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, jobType, startsAt, endsAt])
  @@map("surge_overrides")
}

model CommissionPolicy {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       CommissionScope
  jobType     JobType?        @map("job_type")
  categoryId  String?         @map("category_id") @db.Uuid
  zoneId      String?         @map("zone_id") @db.Uuid
  partnerId   String?         @map("partner_id") @db.Uuid
  campaignCode String?        @map("campaign_code") @db.VarChar(40)
  percent     Decimal         @db.Decimal(5, 2)
  fixedMinor  BigInt          @default(0) @map("fixed_minor")
  priority    Int             @default(0)
  validFrom   DateTime        @map("valid_from") @db.Timestamptz(6)
  validTo     DateTime?       @map("valid_to") @db.Timestamptz(6)
  isActive    Boolean         @default(true) @map("is_active")
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  zone     ServiceZone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([scope, isActive, priority(sort: Desc)])
  @@map("commission_policies")
}

model CancellationPolicy {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType              JobType? @map("job_type")
  zoneId               String?  @map("zone_id") @db.Uuid
  currency             String   @db.VarChar(3)
  gracePeriodSeconds   Int      @map("grace_period_seconds")
  feeBeforeArrivalMinor BigInt  @map("fee_before_arrival_minor")
  feeAfterArrivalMinor BigInt   @map("fee_after_arrival_minor")
  feeAfterStartMinor   BigInt   @default(0) @map("fee_after_start_minor")
  partnerFeeOnCancelMinor BigInt @default(0) @map("partner_fee_on_cancel_minor")
  partnerPenaltyPoints Int      @default(1) @map("partner_penalty_points")
  customerNoShowFeeMinor BigInt @default(0) @map("customer_no_show_fee_minor")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone ServiceZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([jobType, zoneId, isActive])
  @@map("cancellation_policies")
}

// ------------------------------------------------------------- payments
model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId               String        @map("job_id") @db.Uuid
  customerId          String        @map("customer_id") @db.Uuid
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  version             Int           @default(0)
  currency            String        @db.VarChar(3)
  amountMinor         BigInt        @map("amount_minor")
  capturedMinor       BigInt        @default(0) @map("captured_minor")
  refundedMinor       BigInt        @default(0) @map("refunded_minor")
  provider            String        @db.VarChar(40) // cash, wallet, stripe, lahza, ...
  providerRef         String?       @map("provider_ref") @db.VarChar(120)
  providerPayload     Json?         @map("provider_payload")
  failureCode         String?       @map("failure_code") @db.VarChar(60)
  failureReason       String?       @map("failure_reason") @db.VarChar(300)
  idempotencyKey      String        @unique @map("idempotency_key") @db.VarChar(128)
  authorizedAt        DateTime?     @map("authorized_at") @db.Timestamptz(6)
  capturedAt          DateTime?     @map("captured_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  job      Job              @relation(fields: [jobId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([jobId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([providerRef])
  @@map("payments")
}

model PaymentAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  attemptNumber Int      @map("attempt_number")
  action        String   @db.VarChar(20) // AUTHORIZE, CAPTURE, REFUND
  success       Boolean
  providerRef   String?  @map("provider_ref") @db.VarChar(120)
  responseCode  String?  @map("response_code") @db.VarChar(60)
  responseMessage String? @map("response_message") @db.VarChar(300)
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_attempts")
}

model Refund {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  disputeId      String?      @map("dispute_id") @db.Uuid
  status         RefundStatus @default(PENDING)
  currency       String       @db.VarChar(3)
  amountMinor    BigInt       @map("amount_minor")
  reason         String       @db.VarChar(500)
  issuedById     String       @map("issued_by_id") @db.Uuid
  providerRef    String?      @map("provider_ref") @db.VarChar(120)
  ledgerTransactionId String? @map("ledger_transaction_id") @db.Uuid
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(128)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  failureReason  String?      @map("failure_reason") @db.VarChar(300)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment  Payment  @relation(fields: [paymentId], references: [id])
  dispute  Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  issuedBy User     @relation("RefundIssuedBy", fields: [issuedById], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

/// Every inbound webhook is stored first, then processed exactly once (spec §54).
model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(40)
  eventId     String    @map("event_id") @db.VarChar(160)
  eventType   String    @map("event_type") @db.VarChar(80)
  payload     Json
  signatureOk Boolean   @map("signature_ok")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

/// Idempotency store for sensitive endpoints (spec §102). Response is replayed on key reuse.
model IdempotencyKey {
  key          String   @id @db.VarChar(160) // "<userId>:<Idempotency-Key>"
  scope        String   @db.VarChar(60) // e.g. POST /jobs
  requestHash  String   @map("request_hash") @db.VarChar(128)
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  lockedAt     DateTime @default(now()) @map("locked_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// --------------------------------------------------------------- wallet
model Wallet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType      WalletOwnerType @map("owner_type")
  customerId     String?         @unique @map("customer_id") @db.Uuid
  partnerId      String?         @unique @map("partner_id") @db.Uuid
  currency       String          @db.VarChar(3)
  /// Cached value — ALWAYS derivable from ledger_entries; never updated directly (DB trigger blocks it).
  balanceMinor   BigInt          @default(0) @map("balance_minor")
  pendingMinor   BigInt          @default(0) @map("pending_minor")
  isFrozen       Boolean         @default(false) @map("is_frozen")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer      CustomerProfile? @relation("CustomerWallet", fields: [customerId], references: [userId], onDelete: Cascade)
  partner       PartnerProfile?  @relation("PartnerWallet", fields: [partnerId], references: [userId], onDelete: Cascade)
  ledgerAccount LedgerAccount?

  @@map("wallets")
}

model LedgerAccount {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      LedgerAccountType
  code      String            @unique @db.VarChar(80) // e.g. PLATFORM_REVENUE:ILS or WALLET:<walletId>
  walletId  String?           @unique @map("wallet_id") @db.Uuid
  currency  String            @db.VarChar(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet  Wallet?       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@index([type, currency])
  @@map("ledger_accounts")
}

/// A balanced group of entries (sum(debits) == sum(credits)); immutable.
model LedgerTransaction {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LedgerTransactionType
  currency       String                @db.VarChar(3)
  jobId          String?               @map("job_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  refundId       String?               @map("refund_id") @db.Uuid
  withdrawalId   String?               @map("withdrawal_id") @db.Uuid
  disputeId      String?               @map("dispute_id") @db.Uuid
  reference      String?               @db.VarChar(160)
  description    String                @db.VarChar(300)
  reason         String?               @db.VarChar(500)
  actorId        String?               @map("actor_id") @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  job     Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  actor   User?         @relation("LedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  entries LedgerEntry[]

  @@index([jobId])
  @@index([type, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId     String               @map("transaction_id") @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  direction         LedgerEntryDirection
  amountMinor       BigInt               @map("amount_minor") // always positive
  /// Running balance of the account after this entry (for fast statements; recomputable).
  balanceAfterMinor BigInt               @map("balance_after_minor")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("ledger_entries")
}

model Withdrawal {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId     String           @map("partner_id") @db.Uuid
  bankAccountId String           @map("bank_account_id") @db.Uuid
  status        WithdrawalStatus @default(REQUESTED)
  currency      String           @db.VarChar(3)
  amountMinor   BigInt           @map("amount_minor")
  feeMinor      BigInt           @default(0) @map("fee_minor")
  decidedById   String?          @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionReason String?         @map("decision_reason") @db.VarChar(500)
  providerReference String?      @map("provider_reference") @db.VarChar(120)
  paidAt        DateTime?        @map("paid_at") @db.Timestamptz(6)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(128)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner     PartnerProfile     @relation(fields: [partnerId], references: [userId])
  bankAccount PartnerBankAccount @relation(fields: [bankAccountId], references: [id])
  decidedBy   User?              @relation("WithdrawalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("withdrawals")
}

model Receipt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  number        String   @unique @db.VarChar(24)
  currency      String   @db.VarChar(3)
  totalMinor    BigInt   @map("total_minor")
  breakdown     Json
  paymentMethod PaymentMethod @map("payment_method")
  customerName  String   @map("customer_name") @db.VarChar(120)
  serviceNameAr String   @map("service_name_ar") @db.VarChar(120)
  serviceNameEn String   @map("service_name_en") @db.VarChar(120)
  taxNumber     String?  @map("tax_number") @db.VarChar(40)
  pdfMediaId    String?  @map("pdf_media_id") @db.Uuid
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id])

  @@map("receipts")
}

// ------------------------------------------------------------ promotions
model PromoCode {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique @db.VarChar(20)
  description      String?   @db.VarChar(300)
  type             PromoType
  value            Decimal   @db.Decimal(12, 2) // percent or minor units
  maxDiscountMinor BigInt?   @map("max_discount_minor")
  minOrderMinor    BigInt    @default(0) @map("min_order_minor")
  currency         String    @db.VarChar(3)
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  usageLimit       Int?      @map("usage_limit")
  usageCount       Int       @default(0) @map("usage_count")
  perUserLimit     Int       @default(1) @map("per_user_limit")
  firstOrderOnly   Boolean   @default(false) @map("first_order_only")
  jobTypes         JobType[] @map("job_types")
  paymentMethods   PaymentMethod[] @map("payment_methods")
  isActive         Boolean   @default(true) @map("is_active")
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories  PromoCodeCategory[]
  zones       PromoCodeZone[]
  users       PromoCodeUser[]
  redemptions PromoRedemption[]
  jobs        Job[]

  @@index([isActive, startsAt, endsAt])
  @@map("promo_codes")
}

model PromoCodeCategory {
  promoCodeId String @map("promo_code_id") @db.Uuid
  categoryId  String @map("category_id") @db.Uuid

  promoCode PromoCode       @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category  ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, categoryId])
  @@map("promo_code_categories")
}

model PromoCodeZone {
  promoCodeId String @map("promo_code_id") @db.Uuid
  zoneId      String @map("zone_id") @db.Uuid

  promoCode PromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  zone      ServiceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, zoneId])
  @@map("promo_code_zones")
}

model PromoCodeUser {
  promoCodeId String @map("promo_code_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, userId])
  @@map("promo_code_users")
}

model PromoRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  jobId          String   @unique @map("job_id") @db.Uuid
  discountMinor  BigInt   @map("discount_minor")
  currency       String   @db.VarChar(3)
  /// Redemption is reserved at job creation and released if the job is cancelled.
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promoCode PromoCode       @relation(fields: [promoCodeId], references: [id])
  customer  CustomerProfile @relation(fields: [customerId], references: [userId])
  job       Job             @relation(fields: [jobId], references: [id])

  @@index([promoCodeId, customerId])
  @@map("promo_redemptions")
}

model ReferralProgram {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterRewardMinor    BigInt   @map("inviter_reward_minor")
  inviteeRewardMinor    BigInt   @map("invitee_reward_minor")
  currency              String   @db.VarChar(3)
  rewardOn              String   @default("FIRST_COMPLETED_JOB") @map("reward_on") @db.VarChar(30)
  minFirstJobMinor      BigInt   @default(0) @map("min_first_job_minor")
  maxRewardsPerInviter  Int      @default(50) @map("max_rewards_per_inviter")
  codeExpiryDays        Int      @default(90) @map("code_expiry_days")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rewards ReferralReward[]

  @@map("referral_programs")
}

model ReferralReward {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId    String   @map("program_id") @db.Uuid
  inviterId    String   @map("inviter_id") @db.Uuid
  inviteeId    String   @map("invitee_id") @db.Uuid
  triggerJobId String?  @map("trigger_job_id") @db.Uuid
  status       String   @default("PENDING") @db.VarChar(20) // PENDING, GRANTED, BLOCKED
  inviterRewardMinor BigInt @map("inviter_reward_minor")
  inviteeRewardMinor BigInt @map("invitee_reward_minor")
  currency     String   @db.VarChar(3)
  fraudFlags   String[] @map("fraud_flags")
  grantedAt    DateTime? @map("granted_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program ReferralProgram @relation(fields: [programId], references: [id])
  inviter CustomerProfile @relation("ReferralInviter", fields: [inviterId], references: [userId])
  invitee CustomerProfile @relation("ReferralInvitee", fields: [inviteeId], references: [userId])

  @@unique([inviteeId])
  @@index([inviterId])
  @@map("referral_rewards")
}

// -------------------------------------------------------------- reviews
model Review {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String          @map("job_id") @db.Uuid
  raterId   String          @map("rater_id") @db.Uuid
  rateeId   String          @map("ratee_id") @db.Uuid
  direction ReviewDirection
  rating    Int
  tags      String[]
  comment   String?         @db.VarChar(500)
  editableUntil DateTime    @map("editable_until") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rater User @relation("ReviewRater", fields: [raterId], references: [id])
  ratee User @relation("ReviewRatee", fields: [rateeId], references: [id])

  @@unique([jobId, direction])
  @@index([rateeId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ----------------------------------------------------------------- chat
model Chat {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String    @unique @map("job_id") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  job      Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  members  ChatMember[]
  messages Message[]

  @@map("chats")
}

model ChatMember {
  chatId       String    @map("chat_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         String    @db.VarChar(20) // CUSTOMER, PARTNER, SUPPORT
  lastReadAt   DateTime? @map("last_read_at") @db.Timestamptz(6)
  joinedAt     DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt       DateTime? @map("left_at") @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId          String      @map("chat_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  type            MessageType @default(TEXT)
  text            String?     @db.VarChar(2000)
  mediaId         String?     @map("media_id") @db.Uuid
  lat             Decimal?    @db.Decimal(9, 6)
  lng             Decimal?    @db.Decimal(9, 6)
  clientMessageId String      @map("client_message_id") @db.VarChar(64)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  readAt          DateTime?   @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  chat   Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id])
  media  MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([chatId, senderId, clientMessageId])
  @@index([chatId, createdAt(sort: Desc)])
  @@map("messages")
}

// -------------------------------------------------------- notifications
model NotificationTemplate {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event     String              @db.VarChar(60)
  channel   NotificationChannel
  titleAr   String              @map("title_ar") @db.VarChar(160)
  titleEn   String              @map("title_en") @db.VarChar(160)
  bodyAr    String              @map("body_ar") @db.VarChar(1000)
  bodyEn    String              @map("body_en") @db.VarChar(1000)
  isActive  Boolean             @default(true) @map("is_active")
  updatedById String?           @map("updated_by_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([event, channel])
  @@map("notification_templates")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  event     String              @db.VarChar(60)
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  title     String              @db.VarChar(160)
  body      String              @db.VarChar(1000)
  data      Json?
  jobId     String?             @map("job_id") @db.Uuid
  providerRef String?           @map("provider_ref") @db.VarChar(160)
  failureReason String?         @map("failure_reason") @db.VarChar(300)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  userId    String   @id @map("user_id") @db.Uuid
  push      Boolean  @default(true)
  sms       Boolean  @default(true)
  email     Boolean  @default(false)
  marketing Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// -------------------------------------------------------------- support
model SupportTicket {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String         @unique @db.VarChar(20)
  category        TicketCategory
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus   @default(OPEN)
  subject         String         @db.VarChar(120)
  description     String         @db.VarChar(3000)
  raisedById      String         @map("raised_by_id") @db.Uuid
  raisedByRole    String         @map("raised_by_role") @db.VarChar(20) // CUSTOMER / PARTNER
  jobId           String?        @map("job_id") @db.Uuid
  assignedAgentId String?        @map("assigned_agent_id") @db.Uuid
  firstResponseAt DateTime?      @map("first_response_at") @db.Timestamptz(6)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  raisedBy      User             @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedAgent User?            @relation("TicketAssignedTo", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  job           Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]
  attachments   SupportAttachment[]

  @@index([status, priority])
  @@index([raisedById])
  @@index([assignedAgentId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String   @db.VarChar(3000)
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id])
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   MediaAsset      @relation(fields: [mediaId], references: [id])

  @@map("support_attachments")
}

model UserReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  reporterId   String   @map("reporter_id") @db.Uuid
  reportedId   String   @map("reported_id") @db.Uuid
  reason       String   @db.VarChar(40)
  description  String?  @db.VarChar(2000)
  status       String   @default("OPEN") @db.VarChar(20)
  ticketId     String?  @map("ticket_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter User @relation("ReportReporter", fields: [reporterId], references: [id])
  reported User @relation("ReportReported", fields: [reportedId], references: [id])

  @@index([reportedId])
  @@map("user_reports")
}

// ------------------------------------------------------------- disputes
model Dispute {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                 String        @unique @db.VarChar(20)
  jobId                  String        @map("job_id") @db.Uuid
  customerId             String        @map("customer_id") @db.Uuid
  partnerId              String        @map("partner_id") @db.Uuid
  openedByRole           String        @map("opened_by_role") @db.VarChar(20)
  status                 DisputeStatus @default(OPEN)
  reason                 String        @db.VarChar(40)
  description            String        @db.VarChar(3000)
  requestedRefundMinor   BigInt?       @map("requested_refund_minor")
  refundMinor            BigInt        @default(0) @map("refund_minor")
  partnerAdjustmentMinor BigInt        @default(0) @map("partner_adjustment_minor")
  currency               String        @db.VarChar(3)
  decidedById            String?       @map("decided_by_id") @db.Uuid
  decidedAt              DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionReason         String?       @map("decision_reason") @db.VarChar(2000)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  job       Job              @relation(fields: [jobId], references: [id])
  customer  CustomerProfile  @relation("DisputeCustomer", fields: [customerId], references: [userId])
  partner   PartnerProfile   @relation("DisputePartner", fields: [partnerId], references: [userId])
