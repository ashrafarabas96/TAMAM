/// Enables/disables a service type, category or vehicle type inside a zone.
model ZoneServiceRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId        String   @map("zone_id") @db.Uuid
  serviceTypeId String?  @map("service_type_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  vehicleTypeId String?  @map("vehicle_type_id") @db.Uuid
  isEnabled     Boolean  @default(true) @map("is_enabled")
