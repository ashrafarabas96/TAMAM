<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleDisplayName</key>
	<string>تمام</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>tamam_customer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Arabic first; English is the fallback. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Permission prompts. Both languages are shipped; iOS shows the one that
	     matches the device language via InfoPlist.strings. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>نستخدم موقعك لتحديد نقطة الانطلاق وحساب وقت الوصول بدقة. We use your location to set your pickup point and estimate arrival accurately.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>نستخدم موقعك أثناء الطلب لتتبّع الرحلة وحساب وقت الوصول. We use your location during an order to track the trip and estimate arrival.</string>
	<key>NSCameraUsageDescription</key>
	<string>نحتاج الكاميرا لتصوير الطرد أو المشكلة قبل الطلب. The camera is used to photograph your package or the problem before ordering.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>نحتاج الوصول إلى الصور لإرفاقها بطلبك أو بمحادثة الدعم. Photo access lets you attach images to an order or a support chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>لحفظ الصور التي تلتقطها داخل التطبيق. To save photos you take inside the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>نحتاج الميكروفون لتسجيل فيديو يوضّح المشكلة. The microphone is used when you record a video of the problem.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>لقياس أداء العروض داخل التطبيق فقط. Only to measure how in-app offers perform.</string>

	<!-- Deep links: tamam://… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.tamam.customer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tamam</string>
			</array>
		</dict>
	</array>

	<!-- Outbound schemes the app may open. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>https</string>
		<string>mailto</string>
	</array>

	<!-- No ATS exceptions: every endpoint (API, tiles, geocoding) is HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
