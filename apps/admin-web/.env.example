# Public (bundled into the browser build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Server only — used by the /api/session route handlers and middleware.
# API origin reachable from the Next.js server (may differ from the public one inside Docker).
API_INTERNAL_BASE_URL=http://localhost:3000/api/v1
# At least 32 random characters; derives the AES-256-GCM key that encrypts the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Set to "true" behind TLS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false
